# Ignore temporary files and editor/runtime artifacts
.DS_Store
*.swp
*.swo
*.tmp
*~

# Python bytecode, environments, packaging, and test output
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Ignore local environment files
*.env
!platform/versions.env
*.local

# Ignore OS generated files
Thumbs.db

# Ignore kubernetes/helm artifacts and local cluster state
*.kube/
*.kubeconfig
*.kubeconfig.*

# Generated evidence; allow placeholders that preserve the directory layout
evidence/**
!evidence/**/.gitkeep

# Ignore binary or package output
*.log
*.cache
.cache/

# Ignore vscode workspace settings
.vscode/

# Ignore container runtime files
docker-compose.override.yml

# Ignore kubectl or kind temp files
*.yaml.tmp
*.yaml.bak

# Ignore local lab and generated data artifacts
.local/
datasets/releases/sample/tickets.csv
